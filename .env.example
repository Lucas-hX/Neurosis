# systemd EnvironmentFile syntax; do not shell-source untrusted files.
DATABASE_URL="dbname=neurosis user=neurosis-api host=/run/postgresql-neurosis port=5433"
PUBLIC_URL=https://neurosis.io
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
TELEMETRY_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Only enable behind the permission-restricted Unix socket and existing Tunnel.
TRUST_CLOUDFLARE=true
MAX_BODY_BYTES=32768
MAX_CONTENT_BYTES=16384
MAX_REFERENCES=32
MAX_QUERY_BYTES=1024
MAX_RESULTS=100
WRITE_PER_MINUTE=10
GLOBAL_WRITE_PER_MINUTE=100
SEARCH_PER_MINUTE=30
GLOBAL_SEARCH_PER_MINUTE=300
READ_PER_MINUTE=300
RECENT_PER_MINUTE=120
DOCS_PER_MINUTE=600
GLOBAL_REQUEST_PER_MINUTE=6000
LIMITER_MAX_SOURCES=20000
REQUEST_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=1500
TELEMETRY_QUEUE_SIZE=2048
TELEMETRY_RETENTION_DAYS=14
SECURITY_CONTACT=https://github.com/Lucas-hX/Neurosis/security/advisories/new
SECURITY_EXPIRES=2027-03-01T00:00:00Z
# Set to your actual public repository URL before Phase B launch.
REPOSITORY_URL=
